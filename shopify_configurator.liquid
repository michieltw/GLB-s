<!-- Laad de model-viewer bibliotheek in (indien nog niet elders in het thema geladen) -->
<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>

<div class="hockey-stick-configurator" data-section-id="{{ section.id }}">
  <div class="configurator-layout">

    <!-- 3D Viewer Section -->
    <div class="viewer-section">
      <model-viewer
        id="stick-model-viewer-{{ section.id }}"
        src="{{ 'DUMMY_FILE.glb' | file_url }}"
        alt="3D model configurator"
        auto-rotate
        camera-controls
        shadow-intensity="1"
        exposure="1"
        environment-image="legacy"
        style="width: 100%; height: 600px; background-color: {{ section.settings.viewer_bg_color | default: '#f4f4f4' }}; border-radius: 8px;"
      >
        <div class="loading-poster" slot="poster">Laden...</div>
      </model-viewer>
    </div>

    <!-- Options Section -->
    <div class="options-section">
      <h2>{{ section.settings.title | default: 'Configureer je stick' }}</h2>

      <div id="dynamic-options-container-{{ section.id }}">
        {% for block in section.blocks %}

          <div class="option-group"
               id="block-{{ block.id }}"
               data-block-type="{{ block.type }}"
               data-block-id="{{ block.id }}"
               data-condition-trigger="{{ block.settings.condition_trigger }}"
               data-condition-value="{{ block.settings.condition_value }}"
               data-build-code-enabled="{{ block.settings.include_in_build_code }}"
               data-model-action="{{ block.settings.model_action }}"
               {% if block.settings.condition_trigger != blank %}style="display: none;"{% endif %}
          >
            <label for="input-{{ block.id }}">
              {{ block.settings.title }}
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: 'icon' }}" alt="" class="option-icon" width="20" height="20" style="vertical-align: middle; margin-left: 5px;">
              {% endif %}
            </label>

            {% if block.type == 'select_option' %}
              {% assign options = block.settings.options | split: ',' %}
              <select id="input-{{ block.id }}" class="config-select dynamic-input" data-label="{{ block.settings.title | downcase | replace: ' ', '_' }}">
                {% for option in options %}
                  {% assign opt_parts = option | split: ':' %}
                  {% assign opt_label = opt_parts[0] | strip %}
                  {% assign opt_val = opt_parts[1] | default: opt_label | strip %}
                  <option value="{{ opt_val }}">{{ opt_label }}</option>
                {% endfor %}
              </select>
            {% elsif block.type == 'text_input' %}
              <input type="text" id="input-{{ block.id }}" class="config-input dynamic-input" data-label="{{ block.settings.title | downcase | replace: ' ', '_' }}" placeholder="{{ block.settings.placeholder }}" maxlength="{{ block.settings.max_length | default: 50 }}">
            {% endif %}
          </div>

        {% endfor %}
      </div>

      {% if section.settings.show_build_code %}
      <div class="build-code-section">
        <label>{{ section.settings.build_code_title | default: 'Jouw unieke Build Code:' }}</label>
        <div class="build-code-display" id="build-code-display-{{ section.id }}">...</div>
        <small>{{ section.settings.build_code_subtitle | default: 'Gebruik deze code bij je bestelling of voor referentie.' }}</small>
      </div>
      {% endif %}

    </div>
  </div>
</div>

<style>
  .hockey-stick-configurator {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    font-family: inherit;
  }
  .configurator-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .configurator-layout {
      flex-direction: row;
      align-items: flex-start;
    }
  }
  .viewer-section {
    flex: 1 1 60%;
    position: sticky;
    top: 2rem;
  }
  .options-section {
    flex: 1 1 40%;
    background: #fff;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }
  .options-section h2 {
    margin-top: 0;
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }
  .option-group {
    margin-bottom: 1.5rem;
    transition: all 0.3s ease;
  }
  .option-group label {
    display: block;
    font-weight: bold;
    margin-bottom: 0.5rem;
  }
  .config-select, .config-input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1rem;
    background-color: #fafafa;
    box-sizing: border-box;
  }
  .build-code-section {
    margin-top: 1.5rem;
    padding: 1rem;
    background-color: #f8f9fa;
    border: 1px dashed #ccc;
    border-radius: 6px;
    text-align: center;
  }
  .build-code-section label {
    display: block;
    font-weight: bold;
    margin-bottom: 0.5rem;
    color: #333;
  }
  .build-code-display {
    font-family: monospace;
    font-size: 1.25rem;
    font-weight: bold;
    color: #000;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
    word-break: break-all;
  }
  .build-code-section small {
    color: #777;
    font-size: 0.8rem;
  }
  .loading-poster {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.2rem;
    color: #555;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = "{{ section.id }}";
    const container = document.getElementById(`dynamic-options-container-${sectionId}`);
    if (!container) return;

    const allInputs = container.querySelectorAll('.dynamic-input');
    const allGroups = container.querySelectorAll('.option-group');

    function checkConditions() {
      allGroups.forEach(group => {
        const triggerLabel = group.getAttribute('data-condition-trigger');
        const triggerValue = group.getAttribute('data-condition-value');

        if (triggerLabel && triggerLabel.trim() !== '') {
          // Find the input that matches the trigger label
          const formattedTriggerLabel = triggerLabel.toLowerCase().replace(/ /g, '_');
          const triggerInput = container.querySelector(`.dynamic-input[data-label="${formattedTriggerLabel}"]`);

          if (triggerInput) {
            // Check if current value matches the required value (or if any value is fine)
            if (triggerInput.value === triggerValue || triggerValue === '') {
              group.style.display = 'block';
            } else {
              group.style.display = 'none';
            }
          }
        }
      });
    }

    // Attach listeners
    allInputs.forEach(input => {
      input.addEventListener(input.tagName === 'INPUT' ? 'input' : 'change', function() {
        checkConditions();
        // Custom event so the build code and model update script knows a change happened
        document.dispatchEvent(new CustomEvent(`configurator-updated-${sectionId}`));
      });
    });

    // Initial check
    checkConditions();
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = "{{ section.id }}";
    const container = document.getElementById(`dynamic-options-container-${sectionId}`);
    const modelViewer = document.getElementById(`stick-model-viewer-${sectionId}`);
    const buildCodeDisplay = document.getElementById(`build-code-display-${sectionId}`);

    if (!container || !modelViewer) return;

    const baseUrlTemplate = "{{ 'DUMMY_FILE.glb' | file_url }}";

    // Convert hex or named colors to RGBA array for model-viewer
    function parseColor(colorValue) {
      const colors = {
        'Zwart': [0.1, 0.1, 0.1, 1],
        'Wit': [0.9, 0.9, 0.9, 1],
        'Zilver': [0.6, 0.6, 0.6, 1],
        'Rood': [0.8, 0.1, 0.1, 1],
        'Blauw': [0.1, 0.2, 0.8, 1],
        'Groen': [0.1, 0.7, 0.2, 1],
        'Geel': [0.9, 0.8, 0.1, 1],
        'Oranje': [0.9, 0.4, 0.1, 1]
      };

      if (colors[colorValue]) return colors[colorValue];

      // Basic hex parsing if admin provides a hex code #RRGGBB
      if (colorValue.startsWith('#') && colorValue.length === 7) {
        const r = parseInt(colorValue.slice(1, 3), 16) / 255;
        const g = parseInt(colorValue.slice(3, 5), 16) / 255;
        const b = parseInt(colorValue.slice(5, 7), 16) / 255;
        return [r, g, b, 1];
      }
      return null;
    }

    function updateConfigurator() {
      const allGroups = container.querySelectorAll('.option-group');
      let buildCodeParts = [];
      let glbFilenameBase = '';

      let scaleX = 1;
      let scaleY = 1;
      let activeColor = null;

      // 1. Loop through all configured blocks to determine state
      allGroups.forEach(group => {
        // Skip processing if the block is conditionally hidden by the other script
        if (group.style.display === 'none') return;

        const input = group.querySelector('.dynamic-input');
        if (!input) return;

        const val = input.value.trim();
        const action = group.getAttribute('data-model-action');
        const includeInCode = group.getAttribute('data-build-code-enabled') === 'true';

        // Add to build code if enabled and value isn't empty
        if (includeInCode && val !== '') {
          // Format standard options to shortcodes, keep text inputs as is
          let codeStr = val;
          if (input.tagName === 'SELECT') {
            // Very simple abbreviation generator for options
            if (val.length <= 4) {
               codeStr = val.toUpperCase();
            } else if (val.includes(' ')) {
               codeStr = val.split(' ').map(w => w[0]).join('').toUpperCase();
            } else {
               codeStr = val.substring(0, 3).toUpperCase();
            }
          } else {
             codeStr = val.toUpperCase(); // For text inputs like custom name
          }
          buildCodeParts.push(codeStr);
        }

        // Apply 3D model actions based on the block's configured behavior
        if (action === 'set_filename') {
          // E.g. Curve sets the base file "P28"
          glbFilenameBase = glbFilenameBase ? `${glbFilenameBase}-${val}` : val;
        } else if (action === 'mirror_x') {
          // Specifically handles Left/Right where R/Rechts mirrors
          if (val.toUpperCase().startsWith('R')) scaleX = -1;
        } else if (action === 'scale_y') {
          // Specifically handles Length in inches (60 is base)
          const inches = parseFloat(val);
          if (!isNaN(inches) && inches > 0) {
            scaleY = inches / 60.0;
          }
        } else if (action === 'color') {
          activeColor = parseColor(val);
        }
      });

      // 2. Output Build Code
      if (buildCodeDisplay) {
        buildCodeDisplay.textContent = buildCodeParts.join('-') || '...';
      }

      // 3. Update Model Viewer Src
      if (glbFilenameBase) {
        // Assume ST (Standard) variant as fallback if admin didn't map a variant block
        const filename = `${glbFilenameBase}.glb`;
        const newUrl = baseUrlTemplate.replace('DUMMY_FILE.glb', filename);
        if (!modelViewer.src || !modelViewer.src.includes(filename)) {
          modelViewer.src = newUrl;
        }
      }

      // 4. Update Model Viewer Scale
      modelViewer.scale = `${scaleX} ${scaleY} 1`;

      // 5. Update Model Viewer Color
      if (activeColor && modelViewer.model && modelViewer.model.materials) {
        const material = modelViewer.model.materials[0];
        if (material) {
          material.pbrMetallicRoughness.setBaseColorFactor(activeColor);
        }
      }

      // Store current color so the load event can re-apply it if src changes
      modelViewer.dataset.currentColorStr = activeColor ? JSON.stringify(activeColor) : "";
    }

    // When model source finishes loading, re-apply the tint color
    modelViewer.addEventListener('load', function() {
      if (modelViewer.dataset.currentColorStr && modelViewer.model && modelViewer.model.materials) {
        const material = modelViewer.model.materials[0];
        if (material) {
           const colorArr = JSON.parse(modelViewer.dataset.currentColorStr);
           material.pbrMetallicRoughness.setBaseColorFactor(colorArr);
        }
      }
    });

    // Listen for the custom event fired by the conditional logic script
    document.addEventListener(`configurator-updated-${sectionId}`, updateConfigurator);

    // Initial update
    updateConfigurator();
  });
</script>

