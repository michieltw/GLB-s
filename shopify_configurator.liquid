<!-- Laad de model-viewer bibliotheek in (indien nog niet elders in het thema geladen) -->
<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>

<div class="hockey-stick-configurator">
  <div class="configurator-layout">
    <!-- 3D Viewer Section -->
    <div class="viewer-section">
      <model-viewer
        id="stick-model-viewer"
        src="{{ 'P28-ST.glb' | file_url }}"
        alt="3D model of a hockey stick"
        auto-rotate
        camera-controls
        shadow-intensity="1"
        exposure="1"
        environment-image="legacy"
        style="width: 100%; height: 600px; background-color: #f4f4f4; border-radius: 8px;"
      >
        <div class="loading-poster" slot="poster">Laden...</div>
      </model-viewer>
    </div>

    <!-- Options Section -->
    <div class="options-section">
      <h2>Configureer je stick</h2>

      <div class="option-group">
        <label for="curve-select">Curve</label>
        <select id="curve-select" class="config-select">
          <option value="P02">P02</option>
          <option value="P28" selected>P28</option>
          <option value="P88">P88</option>
          <option value="P92">P92</option>
          <option value="P90TM">P90TM</option>
        </select>
      </div>

      <div class="option-group">
        <label for="hand-select">Hand</label>
        <select id="hand-select" class="config-select">
          <option value="Links">Links (Left)</option>
          <option value="Rechts">Rechts (Right)</option>
        </select>
      </div>

      <div class="option-group">
        <label for="flex-select">Flex</label>
        <select id="flex-select" class="config-select">
          <option value="55">55</option>
          <option value="65">65</option>
          <option value="75" selected>75</option>
          <option value="85">85</option>
          <option value="95">95</option>
        </select>
      </div>

      <div class="option-group">
        <label for="kickpoint-select">Kickpoint</label>
        <select id="kickpoint-select" class="config-select">
          <option value="Low">Low</option>
          <option value="Mid" selected>Mid</option>
          <option value="High">High</option>
        </select>
      </div>

      <div class="option-group">
        <label for="color-select">Kleur</label>
        <select id="color-select" class="config-select">
          <option value="Zwart">Zwart</option>
          <option value="Wit">Wit</option>
          <option value="Zilver">Zilver</option>
          <option value="Rood">Rood</option>
          <option value="Blauw">Blauw</option>
          <option value="Groen">Groen</option>
          <option value="Geel">Geel</option>
          <option value="Oranje">Oranje</option>
        </select>
      </div>

      <div class="option-group">
        <label for="texture-select">Textuur</label>
        <select id="texture-select" class="config-select">
          <option value="Matte" selected>Matte</option>
          <option value="Glossy">Glossy</option>
        </select>
      </div>

      <div class="option-group">
        <label for="grip-select">Grip</label>
        <select id="grip-select" class="config-select">
          <option value="Ja" selected>Ja</option>
          <option value="Nee">Nee</option>
        </select>
      </div>

      <div class="option-group">
        <label for="blad-texture-select">Blad textuur</label>
        <select id="blad-texture-select" class="config-select">
          <option value="Standard">Standard</option>
          <option value="Sandpaper">Sandpaper</option>
        </select>
      </div>

      <div class="option-group">
        <label for="length-select">Lengte</label>
        <select id="length-select" class="config-select">
          <option value="60">60"</option>
          <option value="62" selected>62"</option>
          <option value="64">64"</option>
        </select>
      </div>

      <div class="option-group">
        <label for="weight-select">Gewicht</label>
        <select id="weight-select" class="config-select">
          <option value="375g">375g</option>
          <option value="390g">390g</option>
          <option value="415g">415g</option>
        </select>
      </div>

      <div class="option-group">
        <label for="age-class-select">Leeftijdsklasse</label>
        <select id="age-class-select" class="config-select">
          <option value="Youth">Youth</option>
          <option value="Junior">Junior</option>
          <option value="Intermediate">Intermediate</option>
          <option value="Senior" selected>Senior</option>
        </select>
      </div>

      <div class="selected-info">
        <p>Geselecteerde configuratie: <span id="current-filename">P28-ST.glb</span></p>
      </div>

      <div class="build-code-section">
        <label>Jouw unieke Build Code:</label>
        <div class="build-code-display" id="build-code-display">P28-L-75-MID-ZW-MAT-Y-STD-62-375-SR</div>
        <small>Gebruik deze code bij je bestelling of voor referentie.</small>
      </div>
    </div>
  </div>
</div>

<style>
  .hockey-stick-configurator {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    font-family: inherit; /* Inherits from Horizon theme */
  }

  .configurator-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .configurator-layout {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .viewer-section {
    flex: 1 1 60%;
    position: sticky;
    top: 2rem;
  }

  .options-section {
    flex: 1 1 40%;
    background: #fff;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }

  .options-section h2 {
    margin-top: 0;
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .option-group {
    margin-bottom: 1.5rem;
  }

  .option-group label {
    display: block;
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .config-select {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1rem;
    background-color: #fafafa;
  }

  .selected-info {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid #eee;
    font-size: 0.9rem;
    color: #666;
  }

  .build-code-section {
    margin-top: 1.5rem;
    padding: 1rem;
    background-color: #f8f9fa;
    border: 1px dashed #ccc;
    border-radius: 6px;
    text-align: center;
  }

  .build-code-section label {
    display: block;
    font-weight: bold;
    margin-bottom: 0.5rem;
    color: #333;
  }

  .build-code-display {
    font-family: monospace;
    font-size: 1.25rem;
    font-weight: bold;
    color: #000;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
    word-break: break-all;
  }

  .build-code-section small {
    color: #777;
    font-size: 0.8rem;
  }

  .loading-poster {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.2rem;
    color: #555;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Select all our configuration dropdowns
    const selects = {
      curve: document.getElementById('curve-select'),
      hand: document.getElementById('hand-select'),
      flex: document.getElementById('flex-select'),
      kickpoint: document.getElementById('kickpoint-select'),
      color: document.getElementById('color-select'),
      texture: document.getElementById('texture-select'),
      grip: document.getElementById('grip-select'),
      bladTexture: document.getElementById('blad-texture-select'),
      length: document.getElementById('length-select'),
      weight: document.getElementById('weight-select'),
      ageClass: document.getElementById('age-class-select')
    };

    const modelViewer = document.getElementById('stick-model-viewer');
    const filenameDisplay = document.getElementById('current-filename');
    const buildCodeDisplay = document.getElementById('build-code-display');

    // We use a liquid variable to get the base URL for files in Shopify
    // By passing a dummy string, we get the structure of the CDN link
    // and we can replace the dummy filename in JS.
    const baseUrlTemplate = "{{ 'DUMMY_FILE.glb' | file_url }}";

    function updateModel() {
      // Gather all current values
      const vals = {
        curve: selects.curve.value,
        hand: selects.hand.value,
        flex: selects.flex.value,
        kickpoint: selects.kickpoint.value,
        color: selects.color.value,
        texture: selects.texture.value,
        grip: selects.grip.value,
        bladTexture: selects.bladTexture.value,
        length: selects.length.value,
        weight: selects.weight.value,
        ageClass: selects.ageClass.value
      };

      // Map configuration to the 3D files available in the database.
      // Based on Hockey Curve DB, models use Curve and a variant mapping.
      // For this dynamic configurator, we build a generalized filename.
      // Example implementation: map Junior age class to JR variant, else standard ST.
      let variantCode = 'ST';
      if (vals.ageClass === 'Junior' || vals.ageClass === 'Youth') {
          variantCode = 'JR'; // Mapping simplification for example
      }

      // Construct GLB filename (e.g. P28-ST.glb or P28-SBO-JR.glb)
      const filename = `${vals.curve}-${variantCode}.glb`;

      // Update display text to show what the user selected + filename
      filenameDisplay.textContent = `${filename} (Hand: ${vals.hand}, Flex: ${vals.flex})`;

      // Generate and display Build Code
      const buildCodeParts = [
        vals.curve,
        vals.hand === 'Links' ? 'L' : 'R',
        vals.flex,
        vals.kickpoint.toUpperCase(),
        vals.color.substring(0, 2).toUpperCase(), // ZW, WI, ZI, RO, BL, GR, GE, OR
        vals.texture === 'Matte' ? 'MAT' : 'GLO',
        vals.grip === 'Ja' ? 'Y' : 'N',
        vals.bladTexture === 'Standard' ? 'STD' : 'SND',
        vals.length,
        vals.weight.replace('g', ''),
        vals.ageClass === 'Senior' ? 'SR' : (vals.ageClass === 'Junior' ? 'JR' : (vals.ageClass === 'Youth' ? 'YTH' : 'INT'))
      ];
      buildCodeDisplay.textContent = buildCodeParts.join('-');

      // Only change src if the filename is different to prevent unnecessary reloads
      const newUrl = baseUrlTemplate.replace('DUMMY_FILE.glb', filename);
      if (!modelViewer.src || !modelViewer.src.includes(filename)) {
        modelViewer.src = newUrl;
      }

      // Handle Left/Right mirroring and Length scaling via the model-viewer scale property.
      // Assuming original models are Left ("Links") and 60 inches long.
      let scaleX = 1;
      if (vals.hand === 'Rechts') {
        scaleX = -1; // Flip X-axis to mirror the blade
      }

      let scaleY = 1;
      if (vals.length === '62') {
        scaleY = 1.033; // 62 / 60
      } else if (vals.length === '64') {
        scaleY = 1.066; // 64 / 60
      }

      // Apply the scale to the model-viewer
      modelViewer.scale = `${scaleX} ${scaleY} 1`;

      // Apply color dynamically using model-viewer materials API
      // Note: This applies once the model is loaded, so we also need a load listener.
      applyColorToModel(vals.color);
    }

    function applyColorToModel(colorName) {
      if (!modelViewer.model || !modelViewer.model.materials) return;

      // Determine RGBA values based on selection (4 elements required by API)
      let rgba = [0.1, 0.1, 0.1, 1]; // Default Zwart
      if (colorName === 'Wit') {
        rgba = [0.9, 0.9, 0.9, 1];
      } else if (colorName === 'Zilver') {
        rgba = [0.6, 0.6, 0.6, 1];
      } else if (colorName === 'Rood') {
        rgba = [0.8, 0.1, 0.1, 1];
      } else if (colorName === 'Blauw') {
        rgba = [0.1, 0.2, 0.8, 1];
      } else if (colorName === 'Groen') {
        rgba = [0.1, 0.7, 0.2, 1];
      } else if (colorName === 'Geel') {
        rgba = [0.9, 0.8, 0.1, 1];
      } else if (colorName === 'Oranje') {
        rgba = [0.9, 0.4, 0.1, 1];
      }

      // Assuming the stick shaft is the first material.
      // If there are multiple materials (e.g. blade, grip), you might need to iterate.
      const material = modelViewer.model.materials[0];
      if (material) {
        material.pbrMetallicRoughness.setBaseColorFactor(rgba);
      }
    }

    // When the model finishes loading a new src, ensure the current color is applied
    modelViewer.addEventListener('load', function() {
      applyColorToModel(selects.color.value);
    });

    // Add event listeners to all select elements
    Object.values(selects).forEach(selectElement => {
      if(selectElement) {
        selectElement.addEventListener('change', updateModel);
      }
    });

    // Initialize once
    updateModel();
  });
</script>
