    // Helper om texture te creëeren via model-viewer
    async function applyTexture(material, type, url) {
        if (!url || url === "" || url === "null") {
            // Verwijder texture als er geen URL is
            if(type === 'baseColor') {
                if(material.pbrMetallicRoughness.baseColorTexture) {
                   material.pbrMetallicRoughness.baseColorTexture.texture.source.setURI(null);
                }
            } else if (type === 'normal') {
                if(material.normalTexture) {
                   material.normalTexture.texture.source.setURI(null);
                }
            }
            return;
        }

        try {
            let textureObj = textureCache[url];
            if (!textureObj) {
                textureObj = await modelViewer.createTexture(url);
                textureCache[url] = textureObj;
            }

            // Pas de texture toe op basis van het gekozen type (baseColor is meest voorkomend voor overlagen)
            if(type === 'baseColor') {
                // Check of het kanaal bestaat, zo ja overschrijf de image.
                if(material.pbrMetallicRoughness.baseColorTexture) {
                   material.pbrMetallicRoughness.baseColorTexture.texture.source.setURI(url);
                } else {
                   console.warn("Model heeft geen bestaande Base Color map om te overschrijven.");
                }
            } else if (type === 'normal') {
                if(material.normalTexture) {
                   material.normalTexture.texture.source.setURI(url);
                }
            }
        } catch(e) {
            console.error("Fout bij toepassen van texture", e);
        }
    }

    // Hoofdfunctie voor updates
    async function updateConfigurator() {
      const loadingOverlay = document.getElementById(`texture-loading-overlay-${sectionId}`);
      if (loadingOverlay) loadingOverlay.style.display = 'flex';
      if (!modelViewer) return;

      // 1. Model ophalen
      const selectedOption = stickSelect.options[stickSelect.selectedIndex];
      const filename = selectedOption.value;
      const modelLabel = selectedOption.getAttribute('data-label') || '';
      const modelCode = (modelLabel.length > 0) ? modelLabel.replace(/[^a-zA-Z0-9]/g, '').substring(0,3).toUpperCase() : "MOD";
      const extraPrice = parseInt(selectedOption.getAttribute('data-price') || "0");

      if (filename) {
        const fullFilename = filename.toLowerCase().endsWith('.glb') ? filename : filename + '.glb';
        const newUrl = baseUrlTemplate.replace('DUMMY_FILE.glb', fullFilename);
        if (!modelViewer.src || !modelViewer.src.includes(fullFilename)) {
          modelViewer.src = newUrl;
        }
      }
      hiddenModel.value = modelLabel;

      // 2. Transformaties (Schaal & Spiegeling & Slimme Camera)
      let scaleX = 1;
      let scaleY = 1;
      let sideLabel = "Links";
      let sideCode = "L";
      let lengthLabel = "Standaard";
      let lengthCode = "ST";

      sideInputs.forEach(input => {
         if (input.checked) {
             scaleX = parseFloat(input.value);
             sideLabel = input.getAttribute('data-label');
             sideCode = input.getAttribute('data-code');
             input.closest('.radio-box').classList.add('active');

             // Slimme camera: Kijk naar de kant van de blade (gesimuleerd door orbit aan te passen)
             const targetOrbit = input.getAttribute('data-camera-orbit');
             if(targetOrbit && modelViewer.cameraOrbit !== targetOrbit) {
                 // Wacht even tot model geladen is, of forceer
                 modelViewer.cameraTarget = "auto auto auto";
                 modelViewer.cameraOrbit = targetOrbit;
             }
         } else {
             input.closest('.radio-box').classList.remove('active');
         }
      });
      hiddenSide.value = sideLabel;

      lengthInputs.forEach(input => {
         if (input.checked) {
             scaleY = parseFloat(input.value);
             lengthLabel = input.getAttribute('data-label');
             lengthCode = input.getAttribute('data-code');
             input.closest('.radio-box').classList.add('active');
         } else {
             input.closest('.radio-box').classList.remove('active');
         }
      });
      hiddenLength.value = lengthLabel;

      modelViewer.scale = `${scaleX} ${scaleY} 1`;

      // 3. Materialen Toepassen (Kleuren, Finishes en Texturen)
      if (modelViewer.model && modelViewer.model.materials) {

         // 3A. Kleuren (Base Color)
         for (const [idxStr, colorData] of Object.entries(activeColors)) {
             const idx = parseInt(idxStr);
             const material = modelViewer.model.materials[idx];
             if (material) {
                 const rgba = hexToRgbA(colorData.hex);
                 if (rgba) material.pbrMetallicRoughness.setBaseColorFactor(rgba);
             }
         }

         // 3B. Finishes (Roughness / Glans)
         for (const [idxStr, finishData] of Object.entries(activeFinishes)) {
             const idx = parseInt(idxStr);
             const material = modelViewer.model.materials[idx];
             if (material) {
                 const rgh = parseFloat(finishData.roughness);
                 if (!isNaN(rgh)) material.pbrMetallicRoughness.setRoughnessFactor(rgh);
             }
         }

         // 3C. Texturen (Overlagen)
         let texturePromises = [];
         for (const [idxStr, texData] of Object.entries(activeTextures)) {
             const idx = parseInt(idxStr);
             const material = modelViewer.model.materials[idx];
             if (material) {
                 texturePromises.push(applyTexture(material, texData.type, texData.url));
             }
         }
         try {
             if (texturePromises.length > 0) {
                 await Promise.all(texturePromises);
             }
         } catch(e) {
             console.error("Fout tijdens inladen texturen:", e);
         } finally {
             if (loadingOverlay) loadingOverlay.style.display = 'none';
         }

         // Sla state op voor reload
         modelViewer.dataset.currentColors = JSON.stringify(activeColors);
         modelViewer.dataset.currentFinishes = JSON.stringify(activeFinishes);
         modelViewer.dataset.currentTextures = JSON.stringify(activeTextures);
      }

      // 4. Verwerk niet-visuele opties
      let nonVisualCodes = [];
      let extraNonVisualPrice = 0;
      nonVisualSelects.forEach(select => {
          const category = select.getAttribute('data-category');
          const selectedOpt = select.options[select.selectedIndex];
          if(selectedOpt) {
              const label = selectedOpt.value;
              const code = selectedOpt.getAttribute('data-code');
              const price = parseInt(selectedOpt.getAttribute('data-extra-price') || "0");
              extraNonVisualPrice += price;
              nonVisualData[category] = { label: label, code: code, price: price };
              nonVisualCodes.push(code);
          }
      });

      textInputSelects.forEach(input => {
          const category = input.getAttribute('data-category');
          const val = input.value.trim();
          if(val) {
              const price = parseInt(input.getAttribute('data-extra-price') || "0");
              extraNonVisualPrice += price;
              nonVisualData[category] = { label: val, code: val, price: price };
              nonVisualCodes.push(val.substring(0,3).toUpperCase());
          }
      });

      updateHiddenDynamicInputs();

      // 5. Build Code Genereren (Inclusief visuals & non-visuals)
      let colorCodes = Object.values(activeColors).map(c => c.code);
      let finishCodes = Object.values(activeFinishes).map(c => c.code);
      let textureCodes = Object.values(activeTextures).map(c => c.code);

      const parts = [modelCode, lengthCode, sideCode, ...finishCodes, ...textureCodes, ...nonVisualCodes, ...colorCodes];
      const finalCode = parts.filter(p => p).join('-');
      buildCodeDisplay.textContent = finalCode || "...";
      hiddenBuildCode.value = finalCode;

      // 6. Prijs updaten
      let totalExtraOptionsPrice = extraNonVisualPrice;

      for (const [idxStr, colorData] of Object.entries(activeColors)) {
         totalExtraOptionsPrice += (colorData.price || 0);
      }
      for (const [idxStr, finishData] of Object.entries(activeFinishes)) {
         totalExtraOptionsPrice += (finishData.price || 0);
      }
      for (const [idxStr, texData] of Object.entries(activeTextures)) {
         totalExtraOptionsPrice += (texData.price || 0);
      }

      const totalPrice = basePriceCents + extraPrice + totalExtraOptionsPrice;
      if (priceDisplay && totalPrice > 0) {
          priceDisplay.textContent = formatMoney(totalPrice);
      }
    }

    // Init dynamische form UI
    buildDynamicUI();

    // ==========================================
    // Flex & Kickpoint 2D Simulator Logic
    // ==========================================
    const simCanvas = document.getElementById(`simCanvas-${sectionId}`);
    const simModal = document.getElementById(`sim-modal-${sectionId}`);
    const openSimBtn = document.getElementById(`open-sim-modal-${sectionId}`);
    const closeSimBtn = document.getElementById(`close-sim-modal-${sectionId}`);
    const applySimBtn = document.getElementById(`apply-sim-modal-${sectionId}`);
    const simSummary = document.getElementById(`sim-summary-${sectionId}`);

    if (simCanvas && simModal && openSimBtn) {
        const ctx = simCanvas.getContext('2d');
        const tooltip = document.getElementById(`dragTooltip-${sectionId}`);
        const timeSlider = document.getElementById(`timeSlider-${sectionId}`);
        const speedSlider = document.getElementById(`speedSlider-${sectionId}`);
        const unitToggle = document.getElementById(`unitToggle-${sectionId}`);
        const valRot = document.getElementById(`valRot-${sectionId}`);
        const valSpeed = document.getElementById(`valSpeed-${sectionId}`);
        const speedCat = document.getElementById(`speedCat-${sectionId}`);

        // Configuration
        const ROD_LENGTH = 200; // Scaled down for 600x400 canvas
        const CENTER_X = simCanvas.width / 2;
        const CENTER_Y = 100;
        const SEGMENTS = 50;

        // State
        let kp1 = 0.5;
        let flex = 75;
        let useMph = false;
        let dragging = null;
        let precalculatedTips = [];
        const deg2rad = deg => deg * Math.PI / 180;

        function getSpeedCategory(speed) {
            if(speed < 65) return "Beginner";
            if(speed < 95) return "Gemiddeld";
            if(speed < 130) return "Gevorderd";
            if(speed < 160) return "Pro";
            if(speed < 185) return "Elite";
            return "Hardste schot ooit";
        }

        function getKpName(index, val) {
            let v = val * 100;
            if(v >= 80) return "Ultra-Low Kickpoint";
            if(v >= 65) return "Low Kickpoint";
            if(v >= 55) return "Mid-Low Kickpoint";
            if(v >= 40) return "Mid Kickpoint";
            if(v >= 30) return "Amplified Mid Kickpoint";
            return "High Kickpoint";
        }

        function getRawBend(t, speed, currentFlex) {
            let flexFactor = 125 / currentFlex;
            let baseMaxLag = (speed / 200) * 60 * flexFactor;
            let maxLag = baseMaxLag / 1.20;
            let maxWhip = -(maxLag * 0.15);

            if (t < 0.5625) return 0;
            else if (t >= 0.5625 && t < 0.625) {
                let u = (t - 0.5625) / (0.625 - 0.5625);
                return maxLag * 0.5 * (1 - Math.cos(u * Math.PI));
            } else if (t >= 0.625 && t < 0.85) {
                let v = (t - 0.625) / (0.85 - 0.625);
                return maxWhip + (maxLag - maxWhip) * 0.5 * (1 + Math.cos(v * Math.PI));
            } else {
                let w = (t - 0.85) / 0.15;
                return maxWhip * 0.5 * (1 + Math.cos(w * Math.PI));
            }
        }

        function precalculatePhysics() {
            precalculatedTips = [];
            let previousTipAngle = 135;
            let speed = parseFloat(speedSlider.value);

            for(let i=0; i<=1000; i++) {
                let t = i / 1000;
                // Swing range mapped to 135deg (07:30) to 0deg (03:00)
                let baseAngle = 135 - (t * 135);

                // Map the new t back to the original t used for physics
                // (Original swing was 240 to 0. So 135 degrees is when old_t was roughly (240-135)/240 = 0.4375)
                // We compress the remaining 0.5625 of the original animation into the new 1.0 of this animation.
                let old_t = 0.4375 + (t * (1 - 0.4375));

                let rawBend = getRawBend(old_t, speed, flex);
                let actualTip = baseAngle + rawBend;
                if (actualTip > previousTipAngle) actualTip = previousTipAngle;
                previousTipAngle = actualTip;
                precalculatedTips.push(actualTip - baseAngle);
            }
        }

        function drawSim() {
            ctx.clearRect(0, 0, simCanvas.width, simCanvas.height);
            let t = parseInt(timeSlider.value) / 1000;
            let speed = parseFloat(speedSlider.value);

            valRot.innerText = Math.round(t * 135) + "°";
            if(useMph) {
                valSpeed.innerText = Math.round(speed * 0.621371) + " mph";
            } else {
                valSpeed.innerText = speed + " km/h";
            }
            speedCat.innerText = getSpeedCategory(speed);
            drawStick(t, speed);
        }

        function drawStick(t, speed) {
            const baseAngleDeg = 135 - (t * 135);
            const totalBend = precalculatedTips[parseInt(timeSlider.value)] || 0;
            const isBroken = Math.abs(totalBend) > 40;

            // Ghost Line
            ctx.beginPath();
            ctx.moveTo(CENTER_X, CENTER_Y);
            const tipX = CENTER_X + ROD_LENGTH * Math.cos(deg2rad(baseAngleDeg));
            const tipY = CENTER_Y + ROD_LENGTH * Math.sin(deg2rad(baseAngleDeg));
            ctx.lineTo(tipX, tipY);
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
            ctx.lineWidth = 2;
            ctx.setLineDash([5, 5]);
            ctx.stroke();
            ctx.setLineDash([]);

            let currentAngle = baseAngleDeg;
            let curX = CENTER_X;
            let curY = CENTER_Y;
            let segLen = ROD_LENGTH / SEGMENTS;

            let weights = [];
            let weightSum = 0;
            const sigma = 0.12;

            for (let i = 0; i < SEGMENTS; i++) {
                let pos = i / (SEGMENTS - 1);
                let w = Math.exp(-Math.pow(pos - kp1, 2) / (2 * sigma * sigma));
                weights.push(w);
                weightSum += w;
            }

            for (let i = 0; i < SEGMENTS; i++) {
                let wNorm = weights[i] / weightSum;
                let localBend = (wNorm * totalBend);
                currentAngle += localBend;

                let nextX = curX + segLen * Math.cos(deg2rad(currentAngle));
                let nextY = curY + segLen * Math.sin(deg2rad(currentAngle));

                if (isBroken && i > SEGMENTS * kp1) {
                    ctx.beginPath();
                    ctx.moveTo(curX + 20, curY + 20);
                    let brokenEndX = curX + 20 + (ROD_LENGTH - (i*segLen)) * Math.cos(deg2rad(currentAngle - 40));
                    let brokenEndY = curY + 20 + (ROD_LENGTH - (i*segLen)) * Math.sin(deg2rad(currentAngle - 40));
                    ctx.lineTo(brokenEndX, brokenEndY);
                    ctx.strokeStyle = '#ff0000';
                    ctx.lineWidth = 6;
                    ctx.stroke();
                    ctx.fillStyle = "#ff0000";
                    ctx.font = "bold 24px Arial";
                    ctx.fillText("GEBROKEN!", curX + 30, curY);
                    break;
                }

                let intensity = Math.min(1, Math.abs(totalBend) / 40);
                let localIntensity = Math.min(1, Math.abs(localBend * SEGMENTS / 20));
                let finalIntensity = Math.max(intensity * 0.5, localIntensity);
                let hue = 120 - (finalIntensity * 120);

                ctx.beginPath();
                ctx.moveTo(curX, curY);
                ctx.lineTo(nextX, nextY);
                ctx.strokeStyle = `hsl(${hue}, 100%, 50%)`;
                ctx.lineWidth = 6;
                ctx.lineCap = 'round';
                ctx.stroke();

                curX = nextX;
                curY = nextY;
            }

            // Clamp
            ctx.beginPath();
            ctx.arc(CENTER_X, CENTER_Y, 8, 0, Math.PI * 2);
            ctx.fillStyle = '#fff';
            ctx.fill();

            // Drag Node
            let px = CENTER_X + (kp1 * ROD_LENGTH) * Math.cos(deg2rad(baseAngleDeg));
            let py = CENTER_Y + (kp1 * ROD_LENGTH) * Math.sin(deg2rad(baseAngleDeg));
            ctx.beginPath();
            ctx.arc(px, py, dragging === 'kp1' ? 14 : 10, 0, Math.PI * 2);
            ctx.fillStyle = '#00d2ff';
            ctx.fill();
            ctx.strokeStyle = '#fff';
            ctx.lineWidth = 2;
            ctx.stroke();
        }

        function getPointerPos(e) {
            const rect = simCanvas.getBoundingClientRect();
            let clientX = e.touches ? e.touches[0].clientX : e.clientX;
            let clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return {
                x: (clientX - rect.left) * (simCanvas.width / rect.width),
                y: (clientY - rect.top) * (simCanvas.height / rect.height)
            };
        }

        function handlePointerDown(e) {
            const pos = getPointerPos(e);
            let t = parseInt(timeSlider.value) / 1000;
            let baseAngleDeg = 135 - (t * 135);

            let px = CENTER_X + (kp1 * ROD_LENGTH) * Math.cos(deg2rad(baseAngleDeg));
            let py = CENTER_Y + (kp1 * ROD_LENGTH) * Math.sin(deg2rad(baseAngleDeg));
            if (Math.hypot(pos.x - px, pos.y - py) < 25) {
                dragging = 'kp1';
                e.preventDefault();
                tooltip.style.display = 'block';
            }
        }

        function handlePointerMove(e) {
            if (!dragging) return;
            e.preventDefault();
            const pos = getPointerPos(e);
            let t = parseInt(timeSlider.value) / 1000;
            let baseAngleDeg = 135 - (t * 135);

            let vX = Math.cos(deg2rad(baseAngleDeg));
            let vY = Math.sin(deg2rad(baseAngleDeg));
            let dX = pos.x - CENTER_X;
            let dY = pos.y - CENTER_Y;

            let dotProduct = (dX * vX + dY * vY);
            kp1 = Math.max(0.05, Math.min(0.95, dotProduct / ROD_LENGTH));

            let horizontalPercent = Math.max(0, Math.min(1, pos.x / simCanvas.width));
            flex = 125 - (horizontalPercent * 105);

            const rect = simCanvas.getBoundingClientRect();
            let clientX = e.touches ? e.touches[0].clientX : e.clientX;
            let clientY = e.touches ? e.touches[0].clientY : e.clientY;

            tooltip.style.left = (clientX - rect.left + 15) + 'px';
            tooltip.style.top = (clientY - rect.top - 30) + 'px';
            tooltip.innerHTML = `${getKpName(1, kp1)}<br>Flex: ${Math.round(flex)}`;

            precalculatePhysics();
            drawSim();
        }

        function syncSimToConfigurator() {
            // Update nonVisualData so cart gets the properties
            let finalFlex = Math.round(flex);
            nonVisualData["Flex"] = { label: finalFlex + " Flex", code: finalFlex.toString(), price: 0 };

            let kpName = getKpName(1, kp1);
            let kpCode = "KP"; // generic or we can map it based on name
            if(kpName.includes("Low")) kpCode = "LK";
            if(kpName.includes("Mid")) kpCode = "MK";
            if(kpName.includes("High")) kpCode = "HK";
            nonVisualData["Kick-point"] = { label: kpName, code: kpCode, price: 0 };

            if(simSummary) {
                simSummary.textContent = `${finalFlex} Flex, ${kpName}`;
            }

            updateHiddenDynamicInputs();
            updateConfigurator();
        }

        function handlePointerUp() {
            if (dragging) {
                dragging = null;
                tooltip.style.display = 'none';
                // No longer syncing on drop, only when applied
            }
        }

        // Modal open/close logic
        openSimBtn.addEventListener('click', () => {
            simModal.style.display = 'flex';
        });

        if(closeSimBtn) {
            closeSimBtn.addEventListener('click', () => {
                simModal.style.display = 'none';
            });
        }

        if(applySimBtn) {
            applySimBtn.addEventListener('click', () => {
                syncSimToConfigurator();
                simModal.style.display = 'none';
            });
        }

        // Attach sim events
        simCanvas.addEventListener('mousedown', handlePointerDown);
        simCanvas.addEventListener('mousemove', handlePointerMove);
        window.addEventListener('mouseup', handlePointerUp);
        simCanvas.addEventListener('touchstart', handlePointerDown, {passive: false});
        simCanvas.addEventListener('touchmove', handlePointerMove, {passive: false});
        window.addEventListener('touchend', handlePointerUp);

        timeSlider.addEventListener('input', drawSim);
        speedSlider.addEventListener('input', () => {
            precalculatePhysics();
            drawSim();
        });

        unitToggle.addEventListener('click', () => {
            useMph = !useMph;
            unitToggle.innerText = useMph ? "MPH" : "KM/H";
            drawSim();
        });

        // Initialize Sim
        precalculatePhysics();
        drawSim();

        // Initial sync of default sim values to configurator
        syncSimToConfigurator();
    }
    // ==========================================

    // Event Listeners binden
    if (stickSelect) stickSelect.addEventListener('change', updateConfigurator);
    sideInputs.forEach(input => input.addEventListener('change', updateConfigurator));
    lengthInputs.forEach(input => input.addEventListener('change', updateConfigurator));
    nonVisualSelects.forEach(select => select.addEventListener('change', updateConfigurator));
    textInputSelects.forEach(input => input.addEventListener('change', updateConfigurator));

    // Her-apply material data na laden nieuw model
    if (modelViewer) {
        modelViewer.addEventListener('load', function() {
          if (modelViewer.model && modelViewer.model.materials) {

             // Restore Colors
             if (modelViewer.dataset.currentColors) {
                const savedColors = JSON.parse(modelViewer.dataset.currentColors);
                for (const [idxStr, colorData] of Object.entries(savedColors)) {
                    const material = modelViewer.model.materials[parseInt(idxStr)];
                    if (material) {
                        const rgba = hexToRgbA(colorData.hex);
                        if (rgba) material.pbrMetallicRoughness.setBaseColorFactor(rgba);
                    }
                }
             }

             // Restore Finishes
             if (modelViewer.dataset.currentFinishes) {
                const savedFinishes = JSON.parse(modelViewer.dataset.currentFinishes);
                for (const [idxStr, finishData] of Object.entries(savedFinishes)) {
                    const material = modelViewer.model.materials[parseInt(idxStr)];
                    if (material) {
                        const rgh = parseFloat(finishData.roughness);
                        if (!isNaN(rgh)) material.pbrMetallicRoughness.setRoughnessFactor(rgh);
                    }
                }
             }

             // Restore Textures
             if (modelViewer.dataset.currentTextures) {
                const savedTextures = JSON.parse(modelViewer.dataset.currentTextures);
                for (const [idxStr, texData] of Object.entries(savedTextures)) {
                    const material = modelViewer.model.materials[parseInt(idxStr)];
                    if (material) {
                        applyTexture(material, texData.type, texData.url);
                    }
                }
             }
          }
        });

        // Reset camera knop
        const resetBtn = document.getElementById(`reset-camera-btn-${sectionId}`);
        if(resetBtn) {
            resetBtn.addEventListener('click', () => {
                modelViewer.cameraTarget = "auto auto auto";
                modelViewer.cameraOrbit = "0deg 75deg 105%";
            });
        }

        // Snapshot download knop
        const downloadBtn = document.getElementById(`download-snapshot-btn-${sectionId}`);
        if(downloadBtn) {
            downloadBtn.addEventListener('click', async () => {
                try {
                    const blob = await modelViewer.toBlob();
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `Mijn-Stick-Configuratie.png`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                } catch (err) {
                    console.error("Fout bij downloaden snapshot", err);
                    alert("Downloaden is momenteel niet gelukt. Probeer het opnieuw.");
                }
            });
        }
    }

    // First run
    updateConfigurator();
  });
</script>

